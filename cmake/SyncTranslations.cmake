#############################################################################
# Translation catalog sync helper
#
# Invoked as a custom build step (see "Translations" in the top-level
# CMakeLists.txt). Copies the .qm catalogs generated by lrelease in the build
# tree into the translations/ directory of the source tree.
#
# This is needed because the application loads its catalogs from
# "<executable dir>/../translations" (see Application::initializeDefaultPaths),
# which in the in-source-tree layout of this project is
# "<source dir>/translations" - not the build tree. Without this step a rebuilt
# .qm file would never be picked up by the running application, and a stale
# catalog (for example one compiled from an empty .ts) would silently leave the
# user interface in English.
#
# The step keeps working with a single-config and a multi-config generator: it
# only ever looks at the directory lrelease actually wrote to.
#
# Inputs, all passed with -D:
#   QM_BUILD_DIR  - directory containing the .qm files generated by lrelease
#   QM_SOURCE_DIR - translations/ directory of the source tree
#############################################################################

cmake_minimum_required(VERSION 3.21)

if(NOT QM_BUILD_DIR OR NOT QM_SOURCE_DIR)
    message(FATAL_ERROR "SyncTranslations: QM_BUILD_DIR and QM_SOURCE_DIR are required.")
endif()

if(NOT IS_DIRECTORY "${QM_SOURCE_DIR}")
    message(FATAL_ERROR "SyncTranslations: source translations directory not found: ${QM_SOURCE_DIR}")
endif()

file(GLOB _qms RELATIVE "${QM_BUILD_DIR}" "${QM_BUILD_DIR}/saladin_*.qm")

foreach(_qm IN LISTS _qms)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different
            "${QM_BUILD_DIR}/${_qm}"
            "${QM_SOURCE_DIR}/${_qm}"
        RESULT_VARIABLE _result)

    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "SyncTranslations: failed to copy ${_qm} to ${QM_SOURCE_DIR} "
            "(the directory may be read-only for this build)")
    endif()
endforeach()

list(LENGTH _qms _qm_count)
message(STATUS "Synced ${_qm_count} translation catalogs to ${QM_SOURCE_DIR}")
