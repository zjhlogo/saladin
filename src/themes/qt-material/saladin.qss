/*  ------------------------------------------------------------------------  */
/* Saladin overrides for the Qt-Material stylesheet.
/*
/*  This file is appended to dark_teal.qss / light_teal.qss at runtime by
/*  ThemeHelper. The @PRIMARY@, @SECONDARY_LIGHT@, ... placeholders are
/*  replaced with the colors of the active theme (see ThemeHelper::styleSheet()).
/*
/*  Qt-Material is designed for generic forms: its tool buttons, item views and
/*  text edits are much taller and wider than a dual-pane file manager can
/*  afford, and a few of its colors assume generic forms as well. The geometry
/*  and colors that break Saladin are reset here; the remaining Material
/*  colors, borders and hover states stay in effect.
/*  ------------------------------------------------------------------------  */

/*  ------------------------------------------------------------------------  */
/*  Tool buttons (toolbar, drive bar, auxiliary buttons, dialog buttons)  */

QToolButton,
QToolButton:hover,
QToolButton:pressed,
QToolButton:checked,
QToolButton:disabled {
  height: 20px;
  min-height: 0px;
  margin: 0px;
  padding: 2px;
  border: 0px;
}

QToolButton {
  background-color: transparent;
}

/*  ------------------------------------------------------------------------  */
/*  Tab bar  */

/*  Qt-Material sets "height: 28px" on QTabBar::tab:top. As with the header
    sections below, "height" is a sub-control property that cannot be undone by
    "height: auto", so the compact height is spelled out here (the :top
    selector keeps the same specificity as the Qt-Material rule).  */
QTabBar::tab,
QTabBar::tab:top {
  height: 20px;
  min-height: 0px;
  max-height: 24px;
  padding: 2px 8px;
}

/*  ------------------------------------------------------------------------  */
/*  Inputs  */

/*  Qt-Material gives QLineEdit and QComboBox "height: 32px", which made the
    path bar almost twice as tall as the rest of the pane chrome. "height: auto"
    does not reset it, so use explicit bounds; min/max-height are always applied
    to widgets.  */
QLineEdit,
QComboBox {
  height: 20px;
  min-height: 0px;
  max-height: 22px;
  padding: 2px 0px;
}

/*  Spin boxes get the same compact box as the combo boxes above. Qt-Material's
    20px up/down arrow images made a taller box look necessary, but those images
    are canvases whose glyphs sit in the middle with wide margins: measured
    offscreen, the glyphs stay intact in the ~13px buttons that remain.  */
QAbstractSpinBox,
QDateTimeEdit {
  height: 20px;
  min-height: 0px;
  max-height: 22px;
  padding: 2px 6px;
}

QLineEdit:focus,
QComboBox:focus,
QLineEdit:disabled,
QComboBox:disabled {
  height: 20px;
  min-height: 0px;
  max-height: 22px;
  padding: 2px 6px;
}

QAbstractSpinBox:focus,
QDateTimeEdit:focus,
QAbstractSpinBox:disabled,
QDateTimeEdit:disabled {
  height: 20px;
  padding: 2px 6px;
}

/*  Qt-Material paints input text with the primary text color, which Saladin
    pins to black so the text drawn on the bright accent stays readable. On the
    dark color scheme that leaves every input (path bar, dialogs, combo and
    spin boxes) black on a near-black field, so use the theme's regular text
    color instead. The focused (accent) and disabled colors still win, because
    their pseudo-class selectors are more specific.  */
QLineEdit,
QAbstractSpinBox,
QComboBox,
QDateTimeEdit {
  color: @SECONDARY_TEXT@;
}

/*  Combo box drop-down. Qt matches the items of a combo popup with
    "QComboBox::item" (a "QComboBox QAbstractItemView::item" rule does not
    apply), and Qt-Material gives that sub-control "height: 28px" plus an 8px
    transparent border on every side, i.e. a 44px row. As with the tab bar,
    "height" is a sub-control property that must be replaced instead of
    cleared; the padding keeps the text inset that the transparent border used
    to provide, so the popup rows end up the same compact 22px as the rest of
    the UI.  */
QComboBox::item {
  height: 20px;
  border: 0px;
  padding: 1px 8px;
}

QCheckBox,
QRadioButton {
  height: 20px;
  min-height: 18px;
  spacing: 6px;
}

QCheckBox::indicator,
QRadioButton::indicator,
QMenu::indicator,
QListView::indicator,
QTableWidget::indicator {
  width: 18px;
  height: 18px;
}

/*  ------------------------------------------------------------------------  */
/*  Item views and headers  */

QTreeView,
QListView,
QTableView {
  height: 20px;
  padding: 0px;
  border: 0px;
  border-radius: 0px;
}

/*  Qt-Material paints every plain QListView black ("QListView, QComboBox
    { color: #000000 }"), and the pop-up of a combo box is a QListView whose
    items - QFontComboBox draws the family name with the view's text color -
    therefore turned black on the dark pop-up background. The QComboBox rules
    below cannot fix that: they only match the combo box itself, not its view.  */
QListView,
QComboBox QAbstractItemView {
  color: @SECONDARY_TEXT@;
}

QTreeView QLineEdit,
QListView QLineEdit,
QTableView QLineEdit {
  height: 20px;
  padding: 2px;
}

/*  Qt-Material sets an explicit 36px height on header sections. Unlike
    min-width/min-height, "height" is a sub-control property and is applied as
    given, so it must be replaced by a concrete compact value: the section ends
    up at this height plus the vertical padding and the bottom border.  */
QHeaderView::section {
  height: 20px;
  padding: 0px 6px;
}

/*  Qt-Material's 32px min-height is what makes every row of the file list
    almost twice as tall as a dual-pane file manager needs. Clearing it lets a
    row shrink to its natural height (icon/text plus the 1px padding), so the
    rows also follow the font and DPI instead of a fixed pixel size.  */
QTreeView::item,
QListView::item,
QTableView::item {
  padding: 1px;
  min-height: 0px;
}

/*  Qt-Material paints focused selections with the solid accent color; use the
    on-accent text color there so the text stays readable.  */
QTreeView::item:selected:focus,
QListView::item:selected:focus,
QTableView::item:selected:focus {
  color: @PRIMARY_TEXT@;
  selection-color: @PRIMARY_TEXT@;
}

/*  ------------------------------------------------------------------------  */
/*  Menus  */

QMenuBar::item {
  height: 20px;
  padding: 4px 8px;
}

QMenu::item {
  height: 20px;
  padding: 4px 24px 4px 8px;
  border: 0px;
}

/*  ------------------------------------------------------------------------  */
/*  Group boxes (settings dialog)  */

QGroupBox {
  padding: 6px;
  padding-top: 24px;
}

/*  ------------------------------------------------------------------------  */
/*  Viewers  */

QPlainTextEdit {
  padding: 2px 4px;
  border: 1px solid @SECONDARY_LIGHT@;
  border-radius: 0px;
}

/*  The quick guide is plain HTML with light table cells; keep it readable in
    both color schemes by rendering it as a white document.  */
QTextBrowser {
  background-color: #ffffff;
  color: #000000;
  selection-background-color: @PRIMARY@;
  selection-color: @PRIMARY_TEXT@;
}

/*  ------------------------------------------------------------------------  */
/*  Dialog tool buttons: Qt-Material paints them as solid accent blocks  */

QDialog QToolButton,
QDialog QToolButton:hover,
QDialog QToolButton:pressed,
QDialog QToolButton:checked {
  background-color: transparent;
  color: @SECONDARY_TEXT@;
  height: auto;
  margin: 0px;
  padding: 2px;
  border: 0px;
}

/*  ------------------------------------------------------------------------  */
/*  Misc  */

QStatusBar::item {
  border: 0px;
}

QToolTip {
  color: @SECONDARY_TEXT@;
  background-color: @SECONDARY_LIGHT@;
  border: 1px solid @SECONDARY@;
  border-radius: 2px;
  padding: 2px 4px;
}

QMainWindow::separator,
QSplitter::handle {
  background-color: @SECONDARY_LIGHT@;
}